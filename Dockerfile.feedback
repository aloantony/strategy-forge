# esta imagen trae Python listo para correr nuestro mini servidor.
FROM python:3.11-slim

# estas variables dicen "escribe logs al momento" y "usa el puerto 8080".
ENV PYTHONUNBUFFERED=1
ENV PORT=8080

# aqui sera la carpeta de trabajo dentro del contenedor.
WORKDIR /app
# copiamos solo el archivo del servidor al contenedor.
COPY feedback_server.py /app/feedback_server.py

# avisamos que este contenedor escucha en el puerto 8080.
EXPOSE 8080
# este es el comando que se ejecuta al arrancar el contenedor.
CMD ["python", "feedback_server.py"]

